{
  "lexicon": 1,
  "id": "app.temp.commerce.shop",
  "defs": {
    "main": {
      "type": "record",
      "key": "self",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 3000
          },
          "logo": {
            "type": "blob",
            "accept": ["image/*"],
            "maxSize": 1000000
          },
          "website": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          },
          "location": {
            "type": "ref",
            "ref": "app.temp.commerce.defs#location"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
